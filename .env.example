# RAIDYNC 環境変数テンプレート
# 使い方: このファイルを .env にコピーして各値を環境に合わせる。
#   cp .env.example .env
# 実際の .env は .gitignore 済みなのでコミットされない。

# ===== 共通（AWS / DynamoDB）=====
# Lambda・DynamoDB クライアント（server/internal/db/client.go）が参照する。
AWS_REGION=ap-northeast-1
# LocalStack を使うときだけ設定する。空にすると本物の AWS DynamoDB に接続する。
DYNAMODB_ENDPOINT=http://localhost:4566

# ===== 認証（API Gateway authorizer Lambda）=====
# JWT 検証に使う JWKS エンドポイント。ローカルは mock-auth が提供する。
AUTH_JWKS_URL=http://localhost:9229/.well-known/jwks.json
# 期待する発行者（issuer）。mock-auth の MOCK_AUTH_ISSUER と一致させること。
AUTH_ISSUER=http://localhost:9229
# 期待するクライアント ID（任意）。mock-auth の MOCK_AUTH_CLIENT_ID と一致させること。
AUTH_CLIENT_ID=raidync-local-client

# ===== mock-auth サーバー =====
# ※ これらは docker/docker-compose.yml にも定義済み。
#    ローカルで mock-auth を単体起動する場合の参考値。
PORT=9229
MOCK_AUTH_ISSUER=http://localhost:9229
MOCK_AUTH_CLIENT_ID=raidync-local-client
MOCK_AUTH_TOKEN_TTL=3600
