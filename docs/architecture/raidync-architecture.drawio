        <mxCell id="global" value="&lt;b&gt;DynamoDB Global Tables&lt;/b&gt;&lt;br&gt;Players / Sessions / MatchHistory" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.dynamodb;fillColor=#C925D1;" vertex="1" parent="1"><mxGeometry x="860" y="490" width="60" height="60" as="geometry" /></mxCell>
        <mxCell id="gamelift" value="&lt;b&gt;GameLift Managed EC2&lt;/b&gt;&lt;br&gt;Spot フリート（c5.large）&lt;br&gt;UDP 7777・20Hz" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.gamelift;fillColor=#ED7100;" vertex="1" parent="1"><mxGeometry x="1160" y="310" width="60" height="60" as="geometry" /></mxCell>
        <mxCell id="s3" value="&lt;b&gt;S3&lt;/b&gt;&lt;br&gt;GameLift Build（zip）" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.s3;fillColor=#7AA116;" vertex="1" parent="1"><mxGeometry x="1420" y="310" width="60" height="60" as="geometry" /></mxCell>
        <mxCell id="cw" value="&lt;b&gt;CloudWatch&lt;/b&gt;&lt;br&gt;EMF メトリクス・アラーム&lt;br&gt;ダッシュボード（ADR-0007）" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudwatch_2;fillColor=#E7157B;" vertex="1" parent="1"><mxGeometry x="860" y="700" width="60" height="60" as="geometry" /></mxCell>
