        <mxCell id="xray" value="&lt;b&gt;X-Ray&lt;/b&gt;&lt;br&gt;OTLP 直送・Transaction Search&lt;br&gt;（ADR-0008）" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.xray;fillColor=#E7157B;" vertex="1" parent="1"><mxGeometry x="1420" y="700" width="60" height="60" as="geometry" /></mxCell>
        <mxCell id="apigw2" value="&lt;b&gt;API Gateway（REST）&lt;/b&gt;&lt;br&gt;use1.api.raidync.com" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.api_gateway;fillColor=#8C4FFF;" vertex="1" parent="1"><mxGeometry x="300" y="960" width="60" height="60" as="geometry" /></mxCell>
        <mxCell id="lambda2" value="&lt;b&gt;Lambda&lt;/b&gt;&lt;br&gt;authorizer + 5 関数&lt;br&gt;（東京と同じコード）" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;fillColor=#ED7100;" vertex="1" parent="1"><mxGeometry x="560" y="960" width="60" height="60" as="geometry" /></mxCell>
        <mxCell id="tickets2" value="&lt;b&gt;MatchmakingTickets&lt;/b&gt;&lt;br&gt;東京とは別の実体" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.dynamodb;fillColor=#C925D1;" vertex="1" parent="1"><mxGeometry x="860" y="960" width="60" height="60" as="geometry" /></mxCell>
        <mxCell id="global2" value="&lt;b&gt;Global Tables レプリカ&lt;/b&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.dynamodb;fillColor=#C925D1;" vertex="1" parent="1"><mxGeometry x="860" y="1150" width="60" height="60" as="geometry" /></mxCell>
        <mxCell id="gamelift2" value="&lt;b&gt;GameLift Spot フリート&lt;/b&gt;&lt;br&gt;（東京と同構成）" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.gamelift;fillColor=#ED7100;" vertex="1" parent="1"><mxGeometry x="1160" y="960" width="60" height="60" as="geometry" /></mxCell>
        <mxCell id="obs2" value="&lt;b&gt;CloudWatch / SNS / X-Ray&lt;/b&gt;&lt;br&gt;（東京と同構成）" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudwatch_2;fillColor=#E7157B;" vertex="1" parent="1"><mxGeometry x="1420" y="960" width="60" height="60" as="geometry" /></mxCell>
        <mxCell id="title" value="RAIDYNC アーキテクチャ（AWS dev 環境）" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#232F3E;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="700" height="30" as="geometry" /></mxCell>
        <mxCell id="legend" value="&lt;b&gt;主な流れ&lt;/b&gt;&lt;br&gt;① クライアントは Route 53 で最寄りリージョンを引き、Cognito でサインインして JWT を得る&lt;br&gt;② POST /match/request でチケットを発行。応答の endpoint（apne1. / use1.）に以降のポーリングを固定する（セッションアフィニティ）&lt;br&gt;③ GET /match/status のたびに Lambda がマッチを試みる。4 人そろったらチケットを楽観ロックで確保し、GameLift にセッションを作らせる&lt;br&gt;④ クライアントは GameLift のゲームサーバーへ UDP で直接つなぐ（最大 20 分）&lt;br&gt;⑤ セッションが終わると、ゲームサーバーが POST /session/end で結果を報告し、MatchHistory に記録される&lt;br&gt;&lt;b&gt;線&lt;/b&gt;: 実線 = 主経路、破線 = 代替・非同期、太線 = UDP のゲーム通信。GameLift フリートは検証時のみ作成（enable_gamelift）" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#232F3E;fillColor=#F5F5F5;strokeColor=#B3B3B3;spacingLeft=8;spacingTop=4;arcSize=4;" vertex="1" parent="1"><mxGeometry x="190" y="1300" width="1580" height="130" as="geometry" /></mxCell>
        <mxCell id="e0" value="① DNS" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;fontSize=10;fontColor=#232F3E;strokeColor=#545B64;labelBackgroundColor=#FFFFFF;dashed=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="client" target="r53"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="79" y="140" /></Array></mxGeometry></mxCell>
        <mxCell id="e1" value="② HTTPS（REST）" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;fontSize=10;fontColor=#232F3E;strokeColor=#545B64;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="client" target="apigw"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="150" y="673" /><mxPoint x="150" y="340" /></Array></mxGeometry></mxCell>
        <mxCell id="e2" value="use1 側に振られた場合" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;fontSize=10;fontColor=#232F3E;strokeColor=#545B64;labelBackgroundColor=#FFFFFF;dashed=1;exitX=1;exitY=0.7;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="client" target="apigw2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="170" y="705" /><mxPoint x="170" y="990" /></Array></mxGeometry></mxCell>
        <mxCell id="e3" value="① サインイン → JWT" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;fontSize=10;fontColor=#232F3E;strokeColor=#545B64;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.95;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="client" target="cognito"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e4" value="④ UDP 7777（ゲーム通信・ADR-0003）" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;fontSize=10;fontColor=#232F3E;strokeColor=#545B64;labelBackgroundColor=#FFFFFF;strokeWidth=3;strokeColor=#ED7100;exitX=0.25;exitY=0;exitDx=0;exitDy=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="client" target="gamelift"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="60" y="210" /><mxPoint x="1175" y="210" /></Array></mxGeometry></mxCell>
        <mxCell id="e5" value="認可" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;fontSize=10;fontColor=#232F3E;strokeColor=#545B64;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="apigw" target="authz"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e6" value="Lambda プロキシ統合" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;fontSize=10;fontColor=#232F3E;strokeColor=#545B64;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.8;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="apigw" target="handlers"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="440" y="358" /><mxPoint x="440" y="520" /></Array></mxGeometry></mxCell>
        <mxCell id="e7" value="③ Query / TransactWriteItems" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;fontSize=10;fontColor=#232F3E;strokeColor=#545B64;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="handlers" target="tickets"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="760" y="505" /><mxPoint x="760" y="340" /></Array></mxGeometry></mxCell>
        <mxCell id="e8" value="Sessions / MatchHistory" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;fontSize=10;fontColor=#232F3E;strokeColor=#545B64;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.6;exitDx=0;exitDy=0;entryX=0;entryY=0.6;entryDx=0;entryDy=0;" edge="1" parent="1" source="handlers" target="global"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e9" value="③ CreateGameSession&lt;br&gt;CreatePlayerSessions" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;fontSize=10;fontColor=#232F3E;strokeColor=#545B64;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.08;exitDx=0;exitDy=0;entryX=0;entryY=0.66;entryDx=0;entryDy=0;" edge="1" parent="1" source="handlers" target="gamelift"><mxGeometry x="0.4" relative="1" as="geometry"><Array as="points"><mxPoint x="700" y="495" /><mxPoint x="700" y="450" /><mxPoint x="1120" y="450" /><mxPoint x="1120" y="350" /></Array></mxGeometry></mxCell>
        <mxCell id="e10" value="⑤ POST /session/end（結果報告・認証なし＝既知のリスク）" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;fontSize=10;fontColor=#232F3E;strokeColor=#545B64;labelBackgroundColor=#FFFFFF;exitX=0.75;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="gamelift" target="apigw"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1205" y="275" /><mxPoint x="330" y="275" /></Array></mxGeometry></mxCell>
        <mxCell id="e11" value="Build 配布" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;fontSize=10;fontColor=#232F3E;strokeColor=#545B64;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="s3" target="gamelift"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e12" value="EMF（ログ経由）" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;fontSize=10;fontColor=#232F3E;strokeColor=#545B64;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.9;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="handlers" target="cw"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="680" y="544" /><mxPoint x="680" y="730" /></Array></mxGeometry></mxCell>
