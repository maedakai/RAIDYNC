{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ProjectServicesFullOnUsedNamespaces",
      "Effect": "Allow",
      "Action": [
        "dynamodb:*",
        "cognito-idp:*",
        "apigateway:*",
        "lambda:*",
        "gamelift:*",
        "logs:*",
        "cloudwatch:*",
        "sns:*",
        "xray:*"
      ],
      "Resource": "*"
    },
    {
      "Sid": "CloudControlApiForAwsccGameLiftBuild",
      "Effect": "Allow",
      "Action": [
        "cloudformation:CreateResource",
        "cloudformation:GetResource",
        "cloudformation:UpdateResource",
        "cloudformation:DeleteResource",
        "cloudformation:ListResources",
        "cloudformation:GetResourceRequestStatus",
        "cloudformation:CancelResourceRequest"
      ],
      "Resource": "*"
    },
    {
      "Sid": "S3ForGameLiftBuildBucket",
      "Effect": "Allow",
      "Action": "s3:*",
      "Resource": [
        "arn:aws:s3:::raidync-dev-gamelift-build-<ACCOUNT_ID>-*",
        "arn:aws:s3:::raidync-dev-gamelift-build-<ACCOUNT_ID>-*/*"
      ]
    },
    {
      "Sid": "IamRolesScopedToProject",
      "Effect": "Allow",
      "Action": [
        "iam:CreateRole",
        "iam:DeleteRole",
        "iam:GetRole",
        "iam:PassRole",
        "iam:TagRole",
        "iam:UntagRole",
        "iam:ListRoleTags",
        "iam:PutRolePolicy",
        "iam:GetRolePolicy",
        "iam:DeleteRolePolicy",
        "iam:ListRolePolicies",
        "iam:AttachRolePolicy",
        "iam:DetachRolePolicy",
        "iam:ListAttachedRolePolicies",
        "iam:ListInstanceProfilesForRole"
      ],
      "Resource": "arn:aws:iam::<ACCOUNT_ID>:role/raidync-dev-*"
    },
    {
      "Sid": "Route53ForLatencyRouting",
      "Effect": "Allow",
      "Action": [
        "route53:GetHostedZone",
        "route53:ListHostedZones",
        "route53:ListHostedZonesByName",
        "route53:ListResourceRecordSets",
        "route53:ChangeResourceRecordSets",
        "route53:GetChange",
        "route53:ListTagsForResource",
        "route53:ChangeTagsForResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "Route53HealthChecks",
      "Effect": "Allow",
      "Action": [
        "route53:CreateHealthCheck",
        "route53:GetHealthCheck",
        "route53:GetHealthCheckStatus",
        "route53:UpdateHealthCheck",
        "route53:DeleteHealthCheck",
        "route53:ListHealthChecks"
      ],
      "Resource": "*"
    },
    {
      "Sid": "AcmForApiCustomDomains",
      "Effect": "Allow",
      "Action": [
        "acm:RequestCertificate",
        "acm:DescribeCertificate",
        "acm:ListCertificates",
        "acm:DeleteCertificate",
        "acm:AddTagsToCertificate",
        "acm:RemoveTagsFromCertificate",
        "acm:ListTagsForCertificate"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ServiceLinkedRolesForUsedServices",
      "Effect": "Allow",
      "Action": "iam:CreateServiceLinkedRole",
      "Resource": [
        "arn:aws:iam::<ACCOUNT_ID>:role/aws-service-role/replication.dynamodb.amazonaws.com/AWSServiceRoleForDynamoDBReplication",
        "arn:aws:iam::<ACCOUNT_ID>:role/aws-service-role/ops.apigateway.amazonaws.com/AWSServiceRoleForAPIGateway",
        "arn:aws:iam::<ACCOUNT_ID>:role/aws-service-role/application-signals.cloudwatch.amazonaws.com/AWSServiceRoleForCloudWatchApplicationSignals"
      ],
      "Condition": {
        "StringEquals": {
          "iam:AWSServiceName": [
            "replication.dynamodb.amazonaws.com",
            "ops.apigateway.amazonaws.com",
            "application-signals.cloudwatch.amazonaws.com"
          ]
        }
      }
    },
    {
      "Sid": "IamPoliciesScopedToProject",
      "Effect": "Allow",
      "Action": [
        "iam:CreatePolicy",
        "iam:DeletePolicy",
        "iam:GetPolicy",
        "iam:GetPolicyVersion",
        "iam:ListPolicyVersions",
        "iam:CreatePolicyVersion",
        "iam:DeletePolicyVersion",
        "iam:TagPolicy",
        "iam:UntagPolicy",
        "iam:ListPolicyTags"
      ],
      "Resource": "arn:aws:iam::<ACCOUNT_ID>:policy/raidync-dev-*"
    },
    {
      "Sid": "TransactionSearchApplicationSignals",
      "Effect": "Allow",
      "Action": "application-signals:StartDiscovery",
      "Resource": "*"
    },
    {
      "Sid": "TransactionSearchApplicationSignalsServiceLinkedRole",
      "Effect": "Allow",
      "Action": "iam:GetRole",
      "Resource": "arn:aws:iam::<ACCOUNT_ID>:role/aws-service-role/application-signals.cloudwatch.amazonaws.com/AWSServiceRoleForCloudWatchApplicationSignals"
    },
    {
      "Sid": "TransactionSearchCloudTrailChannel",
      "Effect": "Allow",
      "Action": "cloudtrail:CreateServiceLinkedChannel",
      "Resource": "arn:aws:cloudtrail:*:<ACCOUNT_ID>:channel/aws-service-channel/application-signals/*"
    },
    {
      "Sid": "SelfInspectionForTroubleshooting",
      "Effect": "Allow",
      "Action": [
        "iam:GetUser",
        "iam:ListAttachedUserPolicies",
        "iam:ListUserPolicies",
        "iam:GetPolicy",
        "iam:GetPolicyVersion",
        "iam:ListPolicyVersions",
        "iam:SimulatePrincipalPolicy"
      ],
      "Resource": [
        "arn:aws:iam::<ACCOUNT_ID>:user/raidync-cli",
        "arn:aws:iam::<ACCOUNT_ID>:policy/raidync-cli-deploy"
      ]
    },
    {
      "Sid": "Sts",
      "Effect": "Allow",
      "Action": "sts:GetCallerIdentity",
      "Resource": "*"
    }
  ]
}
